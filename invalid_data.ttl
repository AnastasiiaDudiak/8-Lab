@prefix нс:   <http://example.org/emergency#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# НЕВАЛІДНІ приклади (для демонстрації SHACL-валідації)
# Порушення 1–2: немає rdfs:label; дві країни замість однієї
# Порушення 3: від’ємна кількість загиблих
# Порушення 4: магнітуда понад 10
нс:Подія_тест_1 a нс:Землетрус ;
    нс:відбуваєтьсяВ нс:Країна_TUR , нс:Країна_SYR ;
    нс:кількістьЗагиблих -5 ;
    нс:магнітуда "11.2"^^xsd:decimal .

# Порушення 5: код ISO не відповідає шаблону; порушення 6: немає регіону
нс:Країна_тест a нс:Країна ;
    rdfs:label "Тестова країна"@uk ;
    нс:кодISO "tr" .
